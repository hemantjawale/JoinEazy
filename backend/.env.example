# Set these in the hosting dashboard or shell. The local server does not auto-load .env files.
PORT=3001
# Use a long random secret in production. Locally, a key is generated in ignored storage.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
DEMO_ENABLED=true
# Mount persistent storage at /var/data on your Node hosting provider.
DATA_FILE=/var/data/legacy.json
ROUND2_DATA_FILE=/var/data/round2.json
# Optional for direct browser requests. Vercel uses a same-origin API proxy.
APP_ORIGIN=https://your-project.vercel.app
